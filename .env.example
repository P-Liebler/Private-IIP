# Local development values only. Replace every credential before non-local use.
APP_ENV=local
APP_DEBUG=false
POSTGRES_DB=investment
POSTGRES_USER=investment_dev
POSTGRES_PASSWORD=dev-only-change-me
DATABASE_URL=postgresql+asyncpg://investment_dev:dev-only-change-me@postgres:5432/investment
VALKEY_URL=redis://valkey:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=investment_dev
MINIO_SECRET_KEY=dev-only-change-me-minio
MINIO_BUCKET_RAW=raw-ingestions
MINIO_SECURE=false
BASE_CURRENCY=CHF
DEFAULT_TIMEZONE=Europe/Zurich
FRONTEND_ORIGIN=http://localhost:3000
API_PUBLIC_ORIGIN=http://localhost:8000
SESSION_COOKIE_NAME=investment_session
SESSION_TTL_HOURS=168
SESSION_SECURE_COOKIE=false
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
# Generate a unique key with: docker compose run --rm api python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set TOTP_ENCRYPTION_KEY in your ignored .env before enabling TOTP. Never commit it.
TOTP_ENCRYPTION_KEY=
OPENFIGI_API_KEY=
OPENFIGI_BASE_URL=https://api.openfigi.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
INTERNAL_API_BASE_URL=http://api:8000/api/v1
