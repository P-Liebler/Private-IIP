# Local development values only. Replace every credential before non-local use.
APP_ENV=local
APP_DEBUG=false
POSTGRES_DB=investment
POSTGRES_USER=investment_dev
POSTGRES_PASSWORD=dev-only-change-me
DATABASE_URL=postgresql+asyncpg://investment_dev:dev-only-change-me@postgres:5432/investment
VALKEY_URL=redis://valkey:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=investment_dev
MINIO_SECRET_KEY=dev-only-change-me-minio
MINIO_BUCKET_RAW=raw-ingestions
MINIO_SECURE=false
BASE_CURRENCY=CHF
FX_MAX_CARRY_DAYS=5
DEFAULT_TIMEZONE=Europe/Zurich
FRONTEND_ORIGIN=http://localhost:3000
API_PUBLIC_ORIGIN=http://localhost:8000
SESSION_COOKIE_NAME=investment_session
SESSION_TTL_HOURS=168
SESSION_SECURE_COOKIE=false
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
# Generate a unique key with: docker compose run --rm api python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set TOTP_ENCRYPTION_KEY in your ignored .env before enabling TOTP. Never commit it.
TOTP_ENCRYPTION_KEY=
OPENFIGI_API_KEY=
OPENFIGI_BASE_URL=https://api.openfigi.com
# Requires documented source approval AND explicit activation. No live access by default.
SEC_ENABLED=false
CODE_COMMIT=UNVERIFIED
P6_MAX_INSTRUMENTS=30
P6_MAX_SESSIONS=400
P6_MAX_CONCURRENT_RUNS=1
P6_TIMEOUT_SECONDS=240
P8_MAX_INSTRUMENTS=30
P8_TIMEOUT_SECONDS=120
ML_OPERATOR_USERNAMES=[]
ML_TRAINING_TIMEOUT_SECONDS=300
ML_MAX_PENDING_JOBS=2
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
SEC_USER_AGENT=
SEC_CONTACT_EMAIL=
SEC_BASE_URL=https://data.sec.gov
SEC_RATE_LIMIT=5
RESEARCH_COLLECTION_CONTRACTS=[]
# Optional private local assistant; models are pulled explicitly, never by CI.
OLLAMA_CHAT_MODEL=qwen3:0.6b
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m
ASSISTANT_TIMEOUT_SECONDS=60
ASSISTANT_CONTEXT_TOKENS=4096
ASSISTANT_OUTPUT_TOKENS=384
ASSISTANT_CHAT_RETENTION_DAYS=30
ASSISTANT_TEST_MODE=false
DATA_OPERATOR_USERNAMES=[]
DATA_COLLECTION_ENABLED=false
FORWARD_SHADOW_ENABLED=false
DATA_COLLECTION_SCHEDULES=[]
MAX_DAILY_PROVIDER_REQUESTS=100
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
INTERNAL_API_BASE_URL=http://api:8000/api/v1
