{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "prometheus",
        "labels": {
          "app.kubernetes.io/part-of": "investment",
          "investment.local/release-state": "draft"
        },
        "annotations": {
          "investment.local/approval": "NOT_APPROVED"
        }
      },
      "spec": {
        "replicas": 0,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "prometheus"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "prometheus",
              "app.kubernetes.io/part-of": "investment"
            },
            "annotations": {
              "investment.local/approval": "NOT_APPROVED"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "serviceAccountName": "iip-runtime",
            "terminationGracePeriodSeconds": 60,
            "securityContext": {
              "runAsNonRoot": true,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "prometheus",
                "image": "registry.invalid/investment/prometheus:v3.15.1@sha256:fa3302279710be2f21a8301ec17a8b4f2301fd829bd113839b3b6b02b6f191a2",
                "imagePullPolicy": "IfNotPresent",
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "runAsNonRoot": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "2",
                    "memory": "512Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp",
                    "readOnly": false
                  },
                  {
                    "name": "prom-config",
                    "mountPath": "/etc/prometheus",
                    "readOnly": true
                  },
                  {
                    "name": "data",
                    "mountPath": "/prometheus",
                    "readOnly": false
                  }
                ],
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 9090
                  }
                ],
                "command": [
                  "/bin/prometheus"
                ],
                "args": [
                  "--config.file=/etc/prometheus/prometheus.yml",
                  "--storage.tsdb.path=/prometheus",
                  "--storage.tsdb.retention.time=30d"
                ],
                "livenessProbe": {
                  "httpGet": {
                    "path": "/-/healthy",
                    "port": 9090
                  },
                  "periodSeconds": 15,
                  "timeoutSeconds": 6,
                  "failureThreshold": 8
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/-/ready",
                    "port": 9090
                  },
                  "periodSeconds": 15,
                  "timeoutSeconds": 6,
                  "failureThreshold": 8
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "256Mi"
                }
              },
              {
                "name": "prom-config",
                "configMap": {
                  "name": "iip-prometheus"
                }
              },
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "prometheus-data"
                }
              }
            ]
          }
        },
        "strategy": {
          "type": "Recreate"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "iip-prometheus",
        "labels": {
          "app.kubernetes.io/part-of": "investment",
          "investment.local/release-state": "draft"
        },
        "annotations": {
          "investment.local/approval": "NOT_APPROVED"
        }
      },
      "data": {
        "prometheus.yml": "global:\n  scrape_interval: 30s\nscrape_configs:\n  - job_name: private-iip-api\n    metrics_path: /internal/metrics\n    static_configs:\n      - targets: [\"api:8000\"]\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "prometheus",
        "labels": {
          "app.kubernetes.io/part-of": "investment",
          "investment.local/release-state": "draft"
        },
        "annotations": {
          "investment.local/approval": "NOT_APPROVED"
        }
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app.kubernetes.io/name": "prometheus"
        },
        "ports": [
          {
            "name": "http",
            "port": 9090,
            "targetPort": 9090
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "prometheus-data",
        "labels": {
          "app.kubernetes.io/part-of": "investment",
          "investment.local/release-state": "draft"
        },
        "annotations": {
          "investment.local/approval": "NOT_APPROVED",
          "argocd.argoproj.io/sync-options": "Prune=false,Delete=false"
        }
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "storageClassName": "REPLACE_REVIEWED_STORAGE_CLASS",
        "resources": {
          "requests": {
            "storage": "5Gi"
          }
        }
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "prometheus-egress",
        "labels": {
          "app.kubernetes.io/part-of": "investment",
          "investment.local/release-state": "draft"
        },
        "annotations": {
          "investment.local/approval": "NOT_APPROVED"
        }
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "prometheus"
          }
        },
        "policyTypes": [
          "Egress"
        ],
        "egress": [
          {
            "to": [
              {
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "api"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 8000
              }
            ]
          }
        ]
      }
    }
  ]
}
