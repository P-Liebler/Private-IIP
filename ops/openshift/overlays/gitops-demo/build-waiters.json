    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "name": "iip-wait-postgres-dbf6",
        "annotations": {
          "argocd.argoproj.io/hook": "Sync",
          "argocd.argoproj.io/sync-wave": "-47",
          "argocd.argoproj.io/hook-delete-policy": "HookSucceeded,BeforeHookCreation"
        }
      },
      "spec": {
        "backoffLimit": 0,
        "activeDeadlineSeconds": 2100,
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "iip-build-observer"
            }
          },
          "spec": {
            "serviceAccountName": "iip-build-observer",
            "automountServiceAccountToken": true,
            "securityContext": {
              "runAsNonRoot": true,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "restartPolicy": "Never",
            "containers": [
              {
                "name": "wait",
                "image": "image-registry.openshift-image-registry.svc:5000/openshift/cli:latest",
                "imagePullPolicy": "IfNotPresent",
                "command": [
                  "/bin/sh",
                  "-ec"
                ],
                "args": [
                  "set -eu\nname='iip-postgres'\ntag='bootstrap-dbf6b892'\necho \"Waiting for declarative ConfigChange build: $name:$tag\"\nattempt=0\nwhile [ \"$attempt\" -lt 180 ]; do\n  attempt=$((attempt + 1))\n  version=\"$(oc -n gitops-demo get buildconfig \"$name\" -o jsonpath='{.status.lastVersion}' 2>/dev/null || true)\"\n  if [ -n \"$version\" ] && [ \"$version\" != '0' ]; then\n    phase=\"$(oc -n gitops-demo get build \"$name-$version\" -o jsonpath='{.status.phase}' 2>/dev/null || true)\"\n    case \"$phase\" in\n      Complete)\n        if oc -n gitops-demo get imagestreamtag \"$name:$tag\" >/dev/null 2>&1; then\n          echo \"Build $name-$version completed; expected ImageStreamTag exists.\"\n          exit 0\n        fi\n        ;;\n      Failed|Error|Cancelled|Canceled)\n        echo \"Build $name-$version failed with phase $phase. Stopping GitOps Sync.\" >&2\n        exit 1\n        ;;\n    esac\n  fi\n  sleep 10\ndone\necho \"Timeout: build did not complete or expected tag missing for $name\" >&2\nexit 1"
                ],
                "env": [
                  {
                    "name": "HOME",
                    "value": "/tmp"
                  }
                ],
                "securityContext": {
                  "runAsNonRoot": true,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "25m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "250m",
                    "memory": "256Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "16Mi"
                }
              }
            ]
          }
        }
      }
    },
