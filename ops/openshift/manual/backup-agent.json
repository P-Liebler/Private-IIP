{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "backup-stage",
        "namespace": "investment-staging",
        "labels": {
          "app.kubernetes.io/part-of": "investment",
          "investment.local/release-state": "draft"
        },
        "annotations": {
          "investment.local/approval": "NOT_APPROVED",
          "investment.local/manual-only": "true",
          "argocd.argoproj.io/sync-options": "Prune=false,Delete=false"
        }
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "storageClassName": " truenas-nfs",
        "resources": {
          "requests": {
            "storage": "100Gi"
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "backup-agent",
        "namespace": "investment-staging",
        "labels": {
          "app.kubernetes.io/part-of": "investment",
          "investment.local/release-state": "draft",
          "app.kubernetes.io/name": "backup-agent"
        },
        "annotations": {
          "investment.local/approval": "NOT_APPROVED",
          "investment.local/manual-only": "true"
        }
      },
      "spec": {
        "restartPolicy": "Never",
        "automountServiceAccountToken": false,
        "serviceAccountName": "iip-runtime",
        "nodeSelector": {
          "investment.local/backup-approved": "REPLACE_AFTER_REVIEW"
        },
        "securityContext": {
          "runAsNonRoot": true,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "backup-agent",
            "image": "registry.invalid/replace-project/mc@sha256:a6648014767c128e3bbc04bae0d731c1426413bfa4a64d9e451085ea872eda0f",
            "command": [
              "sh",
              "-ec",
              "exec sleep 2147483647"
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "runAsNonRoot": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "resources": {
              "requests": {
                "cpu": "50m",
                "memory": "64Mi"
              },
              "limits": {
                "cpu": "1",
                "memory": "512Mi"
              }
            },
            "env": [
              {
                "name": "MC_HOST_local",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "iip-backup-client",
                    "key": "MC_HOST_local"
                  }
                }
              },
              {
                "name": "MC_CONFIG_DIR",
                "value": "/tmp/.mc"
              },
              {
                "name": "S3_CA_REQUIRED",
                "value": "true"
              },
              {
                "name": "HOME",
                "value": "/tmp"
              }
            ],
            "volumeMounts": [
              {
                "name": "tmp",
                "mountPath": "/tmp"
              },
              {
                "name": "backup-stage",
                "mountPath": "/backup"
              },
              {
                "name": "service-ca",
                "mountPath": "/trusted-ca",
                "readOnly": true
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "tmp",
            "emptyDir": {
              "sizeLimit": "128Mi"
            }
          },
          {
            "name": "backup-stage",
            "persistentVolumeClaim": {
              "claimName": "backup-stage"
            }
          },
          {
            "name": "service-ca",
            "configMap": {
              "name": "iip-service-ca",
              "items": [
                {
                  "key": "service-ca.crt",
                  "path": "root.crt"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "manual-backup-s3-egress",
        "namespace": "investment-staging",
        "labels": {
          "app.kubernetes.io/part-of": "investment",
          "investment.local/release-state": "draft"
        },
        "annotations": {
          "investment.local/approval": "NOT_APPROVED",
          "investment.local/manual-only": "true"
        }
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "backup-agent"
          }
        },
        "policyTypes": [
          "Egress"
        ],
        "egress": [
          {
            "to": [
              {
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "caddy"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 9002
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "manual-backup-s3-ingress",
        "namespace": "investment-staging",
        "labels": {
          "app.kubernetes.io/part-of": "investment",
          "investment.local/release-state": "draft"
        },
        "annotations": {
          "investment.local/approval": "NOT_APPROVED",
          "investment.local/manual-only": "true"
        }
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "caddy"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "backup-agent"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 9002
              }
            ]
          }
        ]
      }
    }
  ]
}
