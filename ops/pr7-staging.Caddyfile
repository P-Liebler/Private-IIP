{$APP_DOMAIN} {
    tls internal
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    }
    @internal path /internal/*
    respond @internal 404
    handle /api/v1/* {
        reverse_proxy pr7-stage-api:8000
    }
    handle {
        reverse_proxy pr7-stage-web:3000
    }
}

caddy:9002 {
    tls internal
    reverse_proxy pr7-target-store:9000
}

# Frozen synthetic backup snapshot, only for isolated migration verification.
caddy:9003 {
    tls internal
    reverse_proxy {$PR7_SOURCE_HOST}:9000
}
