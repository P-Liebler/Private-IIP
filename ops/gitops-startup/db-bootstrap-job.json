{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "iip-db-init-4f3b",
    "annotations": {
      "argocd.argoproj.io/hook": "Sync",
      "argocd.argoproj.io/sync-wave": "0",
      "argocd.argoproj.io/hook-delete-policy": "HookSucceeded,BeforeHookCreation"
    }
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 1200,
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "iip-db-init",
          "app.kubernetes.io/part-of": "investment",
          "investment.local/role": "backend"
        }
      },
      "spec": {
        "serviceAccountName": "iip-runtime",
        "automountServiceAccountToken": false,
        "securityContext": {
          "runAsNonRoot": true,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "restartPolicy": "Never",
        "containers": [
          {
            "name": "alembic-init",
            "image": "image-registry.openshift-image-registry.svc:5000/gitops-demo/iip-backend:bootstrap-4f3b8b83",
            "imagePullPolicy": "Always",
            "command": [
              "python",
              "/bootstrap/bootstrap.py"
            ],
            "envFrom": [
              {
                "configMapRef": {
                  "name": "iip-config"
                }
              }
            ],
            "env": [
              {
                "name": "DATABASE_URL",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "iip-runtime-secrets",
                    "key": "DATABASE_URL"
                  }
                }
              },
              {
                "name": "MINIO_ACCESS_KEY",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "iip-runtime-secrets",
                    "key": "MINIO_ACCESS_KEY"
                  }
                }
              },
              {
                "name": "MINIO_SECRET_KEY",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "iip-runtime-secrets",
                    "key": "MINIO_SECRET_KEY"
                  }
                }
              },
              {
                "name": "HOME",
                "value": "/tmp"
              },
              {
                "name": "XDG_CACHE_HOME",
                "value": "/tmp/cache"
              },
              {
                "name": "MPLCONFIGDIR",
                "value": "/tmp/matplotlib"
              },
              {
                "name": "PYTHONDONTWRITEBYTECODE",
                "value": "1"
              },
              {
                "name": "TOTP_ENCRYPTION_KEY",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "iip-runtime-secrets",
                    "key": "TOTP_ENCRYPTION_KEY"
                  }
                }
              }
            ],
            "securityContext": {
              "runAsNonRoot": true,
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "192Mi"
              },
              "limits": {
                "cpu": "2",
                "memory": "2Gi"
              }
            },
            "volumeMounts": [
              {
                "name": "tmp",
                "mountPath": "/tmp"
              },
              {
                "name": "service-ca",
                "mountPath": "/service-ca",
                "readOnly": true
              },
              {
                "name": "bootstrap",
                "mountPath": "/bootstrap",
                "readOnly": true
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "tmp",
            "emptyDir": {
              "sizeLimit": "128Mi"
            }
          },
          {
            "name": "service-ca",
            "configMap": {
              "name": "iip-service-ca"
            }
          },
          {
            "name": "bootstrap",
            "configMap": {
              "name": "iip-first-use-schema",
              "defaultMode": 292
            }
          }
        ]
      }
    }
  }
}
